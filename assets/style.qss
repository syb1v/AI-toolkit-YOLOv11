/*
 * AI Toolkit YOLO v2 - Modern Dark Theme
 * Улучшенная тёмная тема с градиентами и акцентами
 */

/* === Глобальные стили === */
* {
    font-family: 'Segoe UI', 'Ubuntu', 'Roboto', 'Noto Sans', sans-serif;
}

QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-size: 13px;
}

QMainWindow {
    background-color: #0d1117;
}

/* === Кнопки === */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #21262d, stop:1 #161b22);
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #30363d, stop:1 #21262d);
    border-color: #58a6ff;
}

QPushButton:pressed {
    background: #0d1117;
}

QPushButton:disabled {
    background: #161b22;
    color: #484f58;
    border-color: #21262d;
}

/* Основная кнопка - зелёная */
QPushButton[cssClass="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #238636, stop:1 #1a7f37);
    border-color: #238636;
    color: white;
    font-weight: 600;
}

QPushButton[cssClass="primary"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2ea043, stop:1 #238636);
    border-color: #3fb950;
}

/* Опасная кнопка - красная */
QPushButton[cssClass="danger"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #da3633, stop:1 #b62324);
    border-color: #da3633;
    color: white;
}

QPushButton[cssClass="danger"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #f85149, stop:1 #da3633);
}

/* Маленькие кнопки +/- */
QPushButton[cssClass="small-icon"] {
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    font-size: 16px;
    font-weight: bold;
    border-radius: 6px;
}

QPushButton[cssClass="small-icon"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #388bfd, stop:1 #1f6feb);
    border-color: #58a6ff;
    color: white;
}

/* === Текстовые поля === */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: #388bfd;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #58a6ff;
    background-color: #161b22;
}

/* === Выпадающие списки === */
QComboBox {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 32px;
    min-height: 22px;
    min-width: 80px;
}

QComboBox:hover {
    border-color: #58a6ff;
    background-color: #30363d;
}

QComboBox:focus {
    border-color: #58a6ff;
    outline: none;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 30px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    image: url(assets/arrow_down.svg);
}

QComboBox::down-arrow:hover {
    image: url(assets/arrow_down.svg);
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    selection-background-color: #388bfd;
    padding: 6px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    min-height: 18px;
    border-radius: 4px;
    margin: 2px 0;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #21262d;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #388bfd;
    color: white;
}

/* === Списки и деревья === */
QListWidget, QListView, QTreeWidget, QTreeView {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    show-decoration-selected: 0;
}

QListWidget::item, QTreeWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 2px 0;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #161b22;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #388bfd;
    color: white;
}

/* Убираем синюю рамку выделения у веток дерева */
QTreeView::branch:selected {
    background-color: transparent;
}

QTreeView::branch:hover {
    background-color: transparent;
}

/* === Вкладки === */
QTabWidget::pane {
    background-color: #0d1117;
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: -1px; /* Вместо top, чтобы склеить с табами, но без артефактов */
}

QTabWidget {
    background: transparent;
    border: none;
}

QTabBar::tab {
    background-color: #161b22;
    color: #8b949e;
    border: 1px solid #30363d;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 12px 32px;
    margin-right: 4px;
    font-weight: 500;
    font-size: 14px;
    min-width: 80px;
}

QTabBar::tab:selected {
    background-color: #0d1117;
    color: #58a6ff;
    border-bottom: 3px solid #58a6ff;
}

QTabBar::tab:hover:!selected {
    background-color: #21262d;
    color: #e6edf3;
}

/* === Слайдеры === */
QSlider::groove:horizontal {
    border: none;
    height: 8px;
    background-color: #21262d;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #58a6ff, stop:1 #388bfd);
    border: 2px solid #0d1117;
    width: 20px;
    height: 20px;
    margin: -6px 0;
    border-radius: 10px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #79c0ff, stop:1 #58a6ff);
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #238636, stop:1 #3fb950);
    border-radius: 4px;
}

/* === Прогресс-бар === */
QProgressBar {
    background-color: #21262d;
    border: none;
    border-radius: 8px;
    text-align: center;
    color: #e6edf3;
    height: 28px;
    font-weight: 600;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #238636, stop:0.5 #3fb950, stop:1 #56d364);
    border-radius: 7px;
}

/* === Скроллбары === */
QScrollBar:vertical {
    background-color: #0d1117;
    width: 14px;
    border: none;
    border-radius: 7px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    min-height: 40px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0d1117;
    height: 14px;
    border: none;
    border-radius: 7px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    min-width: 40px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484f58;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Группы === */
QGroupBox {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
    margin-top: 20px;
    padding: 20px 16px 16px 16px;
    font-weight: 600;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    top: 8px;
    padding: 4px 12px;
    color: #58a6ff;
    background-color: #21262d;
    border-radius: 12px;
}

/* === Лейблы === */
QLabel {
    color: #e6edf3;
    background: transparent;
}

QLabel[cssClass="title"] {
    font-size: 20px;
    font-weight: 700;
    color: #58a6ff;
}

QLabel[cssClass="subtitle"] {
    font-size: 13px;
    color: #8b949e;
}

QLabel[cssClass="success"] {
    color: #3fb950;
}

QLabel[cssClass="warning"] {
    color: #d29922;
}

QLabel[cssClass="error"] {
    color: #f85149;
}

QLabel[cssClass="hint"] {
    color: #8b949e;
    font-size: 12px;
    font-style: italic;
}

/* === Чекбоксы === */
QCheckBox {
    spacing: 10px;
    color: #e6edf3;
    background: transparent;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #30363d;
    border-radius: 6px;
    background-color: #0d1117;
}

QCheckBox::indicator:checked {
    background-color: #238636;
    border-color: #238636;
}

QCheckBox::indicator:hover {
    border-color: #58a6ff;
}

/* === Радиокнопки === */
QRadioButton {
    spacing: 10px;
    color: #e6edf3;
    background: transparent;
}

QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #30363d;
    border-radius: 11px;
    background-color: #0d1117;
}

QRadioButton::indicator:checked {
    background-color: #238636;
    border-color: #238636;
}

QRadioButton::indicator:hover {
    border-color: #58a6ff;
}

/* === Меню === */
QMenuBar {
    background: transparent;
    border: none;
    height: 0px;
    max-height: 0px; /* Принудительно скрываем */
}

QMainWindow::separator {
    background: transparent;
    width: 0px;
    height: 0px;
}

QMenuBar::item {
    padding: 0;
    border: none;
}

QMenuBar::item:selected {
    background-color: #21262d;
}

QMenu {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    padding: 10px 30px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #388bfd;
}

QMenu::separator {
    height: 1px;
    background-color: #30363d;
    margin: 6px 8px;
}

/* === Статусбар === */
QStatusBar {
    background-color: #161b22;
    color: #8b949e;
    border-top: 1px solid #30363d;
    padding: 4px;
}

/* === Tooltip === */
QToolTip {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 12px;
}

/* === Разделители === */
QSplitter::handle {
    background-color: #21262d;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #58a6ff;
}

/* === SpinBox === */
QSpinBox, QDoubleSpinBox {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 10px;
    padding-right: 35px;
    min-height: 24px;
    min-width: 60px;
    selection-background-color: #388bfd;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #58a6ff;
    background-color: #161b22;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #30363d;
    border-top-right-radius: 5px;
    background-color: #21262d;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border-left: 1px solid #30363d;
    border-top: 1px solid #30363d;
    border-bottom-right-radius: 5px;
    background-color: #21262d;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #388bfd;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #388bfd;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #1f6feb;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(assets/arrow_up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
    image: url(assets/arrow_up.svg); /* Можно добавить hover-версию */
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(assets/arrow_down.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
    image: url(assets/arrow_down.svg);
}

/* === Кастомные классы === */

/* Карточка */
QFrame[cssClass="card"] {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
    padding: 16px;
}

/* Панель инструментов */
QFrame[cssClass="toolbar"] {
    background-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 10px;
    padding: 8px 12px;
}

/* Лог-виджет */
QPlainTextEdit[cssClass="log"] {
    background-color: #0d1117;
    color: #7ee787;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', 'Monaco', monospace;
    font-size: 12px;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px;
}
